<div class="container">
  <div class="slide-nav">
    <button id="prevBtn" onclick="prev()" disabled>&larr; Previous</button>
    <span class="counter" id="counter">1 / 6</span>
    <button id="nextBtn" onclick="next()">Next &rarr;</button>
  </div>
</div>

<script>
let current = 0;
const total = 6;

function goTo(i) {
  document.querySelectorAll('.slide').forEach(s => s.classList.remove('active'));
  document.getElementById('slide-' + i).classList.add('active');
  document.querySelectorAll('.progress-bar button').forEach((b, idx) => {
    b.classList.toggle('active', idx === i);
  });
  current = i;
  document.getElementById('prevBtn').disabled = (i === 0);
  document.getElementById('nextBtn').disabled = (i === total - 1);
  document.getElementById('counter').textContent = (i + 1) + ' / ' + total;
  window.scrollTo({top: 0, behavior: 'smooth'});
}

function next() { if (current < total - 1) goTo(current + 1); }
function prev() { if (current > 0) goTo(current - 1); }

document.addEventListener('keydown', e => {
  if (e.key === 'ArrowRight') next();
  if (e.key === 'ArrowLeft') prev();
});
</script>

